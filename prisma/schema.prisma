// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

enum Language {
  js
  py
  bash
  cpp
  sql
  dart
  java
  html
}

model Log {
  id        String   @id @default(uuid())
  code      String
  createdAt DateTime @default(now())
  roomId    String
  room      Room     @relation(references: [id], fields: [roomId], onDelete: Cascade)

  @@index([roomId, createdAt(sort: Desc)], map: "logs_roomId_createdAt_idx")
  @@map("logs")
}

model Room {
  id                      String       @id @default(uuid())
  students                String[]
  teacher                 String
  taskId                  String?
  language                Language     @default(py)
  studentCursorEnabled    Boolean      @default(false)
  studentSelectionEnabled Boolean      @default(false)
  studentEditCodeEnabled  Boolean      @default(false)
  completed               Boolean      @default(false)
  lessonRevision          Int          @default(0)
  lessonKey               String       @default("free")
  lessonTask              Json?
  lessonSnapshot          String?
  lessonCodeInline        Boolean      @default(false)
  lessonDrafts            RoomLessonDraft[]
  lessonHistory           RoomLessonVisit[]
  presenceHistory         RoomPresence[]
  completedAt             DateTime?
  logs                    Log[]
  roomMembers             RoomMember[]
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @default(now()) @updatedAt

  @@index([teacher, createdAt(sort: Desc)], map: "rooms_teacher_createdAt_idx")
  @@index([students], type: Gin, map: "rooms_students_idx")
  @@map("rooms")
}

model RoomMember {
  id         String   @id @default(uuid())
  telegramId String
  username   String?
  roomId     String
  room       Room     @relation(references: [id], fields: [roomId], onDelete: Cascade)
  joinedAt   DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([telegramId, roomId])
  @@index([roomId], map: "room_members_roomId_idx")
  @@map("room_members")
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model RoomLessonDraft {
  roomId   String
  key      String
  language Language
  snapshot String
  codeInline Boolean @default(false)
  room     Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([roomId, key])
  @@map("room_lesson_drafts")
}

model PersonalLessonTask {
  id        String   @id @default(uuid())
  owner     String
  moduleId  Int
  payload   Json
  createdAt DateTime @default(now())

  @@index([owner, moduleId, createdAt])
  @@map("personal_lesson_tasks")
}

model RoomLessonVisit {
  roomId     String
  revision   Int
  taskKey    String
  title      String
  language   Language
  startedAt  DateTime
  endedAt    DateTime?
  snapshot   String?
  room       Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([roomId, revision])
  @@map("room_lesson_visits")
}

model RoomPresence {
  id           String @id
  roomId       String
  participant  String
  displayName  String?
  kind         String
  role         String
  joinedAt     DateTime
  lastSeenAt   DateTime
  leftAt       DateTime?
  room         Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, joinedAt])
  @@map("room_presence")
}
